Meta.DisplayName=Horizon (Minecraft 26.3 in Rust)
Meta.Description=Horizon dedicated server: a Rust rewrite of Minecraft Java Edition 26.3. Vanilla 26.3 and Horizon clients can join.
Meta.OS=Linux
Meta.AarchSupport=None
Meta.Arch=x86_64
Meta.Author=Horizon Ports
Meta.URL=https://playhorizon.dev
Meta.DisplayImageSource=
Meta.EndpointURIFormat=
Meta.ConfigManifest=horizon-serverconfig.json
Meta.MetaConfigManifest=horizon-servermetaconfig.json
Meta.ConfigRoot=horizon-server.kvp
Meta.MinAMPVersion=2.6.3.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["python3","curl","ca-certificates"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=954e5650-c94e-4618-b590-a0aeb6a518fd
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Horizon
App.RootDir=./horizon/
App.BaseDirectory=./horizon/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=/bin/bash
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs="{{$FullBaseDir}}amp-start.sh" "{{$FullBaseDir}}" {{$ServerPort}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"HORIZON_EULA":"{{HorizonEula}}","HORIZON_WORLD":"{{HorizonWorld}}","HORIZON_SEED":"{{HorizonSeed}}","HORIZON_WHITELIST":"{{HorizonWhitelist}}","HORIZON_OP":"{{HorizonOp}}","HORIZON_NO_AUDIO":"1"}
App.CommandLineParameterFormat=--{0} {1}
App.CommandLineParameterDelimiter= 
App.ExitMethod=String
App.ExitTimeout=180
App.ExitString=stop
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[horizon-serverports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ServerPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=20
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[horizon-serverupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.toml","*.json","*.properties","*.txt"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^.*\]: Done \([\d.]+s\)!
Console.UserJoinRegex=^.*\]: (?<username>\w+) joined the game$
Console.UserLeaveRegex=^.*\]: (?<username>\w+) left the game$
Console.UserChatRegex=^.*\]: (?:\[Not Secure\] )?<(?<username>\w+)> (?<message>.+)$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
